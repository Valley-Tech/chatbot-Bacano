# Variables de BacanoBot. Copia este archivo a .env (local) o ponlas en Railway.

# ---- Meta / WhatsApp ---------------------------------------------------------
WEBHOOK_VERIFY_TOKEN=
API_TOKEN=                      # token de usuario del sistema (solo si CRM_MODE=mirror o para descargar comprobantes)
BUSINESS_PHONE=                 # phone_number_id del número de Bacano
API_VERSION=v23.0
BASE_URL=https://graph.facebook.com
APP_SECRET=                     # para validar la firma del endpoint /flow
PORT=3000

# ---- CRM ValleyTech --------------------------------------------------------------
CRM_MODE=gateway                # gateway: el CRM entrega y envía los mensajes · mirror: el bot habla con Meta y se refleja en el CRM
CRM_BASE_URL=https://crm-valleytech-production.up.railway.app
CRM_API_KEY=                    # clave del chatbot en el CRM (Chatbots → BacanoBot)
CRM_SIGNING_SECRET=
CRM_PHONE_NUMBER_ID=            # igual a BUSINESS_PHONE

# ---- Catálogo y Flow ----------------------------------------------------------
CATALOG_ID=                     # ID del catálogo de Bacano en el Administrador de ventas de Meta
CATALOG_TEMPLATE=               # (opcional) plantilla con botón "Ver catálogo"
CATALOG_TEMPLATE_LANG=es_CO
VARIANTES_META=true             # una tarjeta por grupo de variantes en las cartas (false = cada variante por separado)
FLOW_ID_PEDIDO=                 # Flow de datos de entrega y pago (pantallas DETAILS → SUMMARY → SUCCESS)
PRIVATE_KEY=                    # clave privada del Flow (ver scripts/clave-flow.mjs y scripts/probar-clave.mjs)
PASSPHRASE=

# ---- Negocio -------------------------------------------------------------------
NOTIFY_NUMBERS=                 # números que reciben el aviso de cada pedido, separados por coma: 57300...,57311...
PLANTILLA_PEDIDO=nuevo_pedido   # plantilla de aviso (6 variables: nombre, celular, entrega, pedido, pago, total)
PLANTILLA_COMPROBANTE=comprobante_pago
IMAGEN_PEDIDO_URL=              # imagen del encabezado de las plantillas de aviso
DOMICILIO_VALOR=3000            # valor del domicilio (0 si no se cobra)
HORA_APERTURA=17:00             # turno del chatbot (hora Colombia): 5:00 p. m.
HORA_CIERRE=23:00               # a 11:00 p. m. La bienvenida sale 1 vez por turno.
CUENTAS_BANCARIAS=              # texto para transferencias (usa \n para saltos de línea): *Nequi:* 300... - Nombre
CONTACTO_TELEFONO=              # número que se envía al escribir "asesor" (si está vacío, el primero de NOTIFY_NUMBERS)
UBICACION_NOMBRE=Bacano
UBICACION_DIRECCION=            # dirección del local
UBICACION_LAT=                  # coordenadas (Google Maps → clic derecho sobre el local → copiar "lat, lng")
UBICACION_LNG=
CARTA_URL=                      # (opcional) PDF o imagen pública de la carta; se envía al escribir "carta"
RECORDATORIO_PEDIDO_MIN=5       # recordar el pedido sin terminar cada 5 min…
RECORDATORIO_PEDIDO_MAX=2       # …máximo 2 veces (0 = no recordar)
ADICIONAL_MINUTOS=60            # carrito dentro de 60 min tras llenar el Flow → se ofrece como ADICIONAL
SOLO_CON_FOTO=true              # carrusel/tarjeta solo con productos con foto en Meta (según docs/catalogo-meta-bacano.csv)
VERIFICAR_FOTOS=true            # además revisa en línea que cada foto exista
TARJETAS_CARRUSEL=true          # false → 2 a 10 platos van en lista de productos en vez de carrusel
NO_RESPONDER_A=                 # números (personal del restaurante) a los que el bot no responde: 57300...,57311...

# ---- Loggro POS (Pirpos) ---------------------------------------------------------
LOGGRO_API_KEY=                 # API key de Bacano en Loggro (sin ella el pedido no se manda al POS)
LOGGRO_TABLE_ID=                # _id de la mesa donde caen los pedidos de WhatsApp (p. ej. "Domicilios")
LOGGRO_LOCATION_STOCK=          # bodega; si queda vacía se usa la del JSON: 6adf9722e16722d5265b03ae (General)
LOGGRO_DOMICILIO_PRODUCT_ID=    # (opcional) producto "Domicilio" en Loggro para que la comanda lo incluya

# ---- Google Sheets (cuenta de servicio) -------------------------------------------
SPREADSHEETID_PEDIDO=           # hoja de pedidos (compártela como Editor con GOOGLE_CLIENT_EMAIL)
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# ---- AWS S3 (comprobantes de transferencia) ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=micarta
